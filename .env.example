# =============================================
# Frontend Environment (Exposed to browser)
# ONLY use VITE_ prefix for values safe to expose
# =============================================

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Cloudflare Worker API URL
VITE_API_URL=https://your-worker-subdomain.workers.dev

# =============================================
# Cloudflare Worker Environment (NEVER expose to browser)
# =============================================

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Worker authentication secret (used for internal service-to-service auth if needed)
WORKER_AUTH_SECRET=generate-a-secure-random-secret-here
